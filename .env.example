# ==============================================================================
# Supabase Configuration Template for University Leave Management System
# Copy this file to .env.local on your machine and fill in your Supabase values.
# ==============================================================================

# 1. Supabase Project URL (Found under Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# 2. Supabase Anon / Publishable Key (Found under Project Settings -> API)
# Safe for browser/client-side queries protected by Supabase Row Level Security (RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# 3. Supabase Service Role Secret Key (Found under Project Settings -> API)
# REQUIRED on the server for Admin & HOD staff account creation (auth.admin.createUser)
# NEVER prefix with NEXT_PUBLIC_ and NEVER expose in client bundles!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

